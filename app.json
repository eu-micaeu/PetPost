{
  "expo": {
    "name": "PetPost",
    "slug": "petpost",
    "scheme": "petpost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.petpost"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#111016"
      },
      "package": "com.anonymous.petpost"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111016"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04df41d9-5333-4989-b9b5-2f512f71670d"
      }
    },
    "owner": "micarrocha"
  }
}
